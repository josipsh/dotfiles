#!/bin/bash

echo "PWD: ${PWD}"

if [[ -d ~/.agents ]]; then 
    echo "~agents folder exists"
else
    echo "~agents folder dies not exists, creating"
    mkdir ~/.agents
    echo "~agents folder created!"
fi
echo
if [[ -d ~/.opencode ]]; then 
    echo "~.opencode folder exists"
else
    echo "~.opencode folder dies not exists, creating"
    mkdir ~/.opencode
    echo "~.opencode folder created!"
fi
echo

if [[ -d ~/.config ]]; then 
    echo "~.config folder exists"
else
    echo "~.config folder dies not exists, creating"
    mkdir ~/.config
    echo "~.config folder created!"
fi
echo


function create_or_recreate {
    if [[ -L $2 ]]; then
        echo "$2 link already exists, recreating..."
        unlink $2
        ln -s $1 $2
        echo "$2 is recreated!"
    else
        echo "$2 link does not exists, creating..."
        ln -s $1 $2
        echo "$2 is created!"
    fi
}

create_or_recreate "${PWD}/.agents/AGENTS.md" ~/.agents/AGENTS.md
echo
create_or_recreate "${PWD}/.agents/skills" ~/.agents/skills
echo

create_or_recreate "${PWD}/.opencode/agents" ~/.opencode/agents
echo
create_or_recreate "${PWD}/.opencode/opencode.jsonc" ~/.opencode/opencode.jsonc
echo
create_or_recreate "${PWD}/config/starship.toml" ~/.config/starship.toml
